{
  "name": "@noi258/dsh-session-tools",
  "version": "0.1.0",
  "description": "DSH 会话工具：把 zstd 事件流导出成可读对话、生成会话索引、校验「YAML 主体 + Markdown 附录」格式的文件",
  "private": true,
  "type": "commonjs",
  "bin": {
    "dsh-export-session": "./export-session.mjs",
    "dsh-index-sessions": "./index-sessions.cjs",
    "dsh-check-md": "./check-md.cjs",
    "dsh-search-sessions": "./search-sessions.mjs"
  },
  "files": [
    "export-session.mjs",
    "index-sessions.cjs",
    "check-md.cjs",
    "search-sessions.mjs",
    "lib/session-decode.mjs",
    "README.md",
    "MAINTENANCE.md",
    "LICENSE",
    "test/run-tests.mjs"
  ],
  "engines": {
    "node": ">=18"
  },
  "dependencies": {
    "yaml": "^2.4.0"
  },
  "scripts": {
    "test": "node test/run-tests.mjs"
  },
  "keywords": [
    "dsh",
    "deepseek-harness",
    "session",
    "export",
    "markdown",
    "zstd",
    "search",
    "grep",
    "cli"
  ],
  "author": "NOI258",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/NOI258/dsh-session-tools.git"
  },
  "bugs": {
    "url": "https://github.com/NOI258/dsh-session-tools/issues"
  },
  "homepage": "https://github.com/NOI258/dsh-session-tools#readme"
}
